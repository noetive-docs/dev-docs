{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Noetive",
  "colors": {
    "primary": "#a855f7",
    "light": "#a855f7",
    "dark": "#a855f7"
  },
  "description": "Noetive Developer Documentation",
  "favicon": "/images/favicon-32x32.png",
  "logo": {
    "light": "/images/noetive-logo-io-lightbg.png",
    "dark": "/images/noetive-logo-io-darkbg.png",
    "href": "https://www.noetive.io"
  },
  "background": {
    "decoration": "gradient",
    "light": "#FDFBF7",
    "dark": "#0f172a"
  },
  "appearance": {
    "default": "system"
  },
  "font": {
    "headings": {
      "family": "Outfit"
    },
    "body": {
      "family": "Space Grotesk"
    }
  },
  "css": "style.css",
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page doesn't exist or has moved."
    }
  },
  "search": {
    "prompt": "Search docs..."
  },
  "seo": {
    "indexing": "all"
  },
  "api": {
    "examples": {
      "prefill": true
    }
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "integrations": {
    "gtm": {
      "tagId": "GTM-TV46FJWQ"
    }
  },
  "anchors": [
    {
      "name": "GitHub",
      "icon": "github",
      "url": "https://github.com/noetive"
    },
    {
      "name": "Support",
      "icon": "mail",
      "url": "https://www.noetive.io/support"
    }
  ],
  "topbar": {
    "links": [
      { "name": "Semantik", "url": "https://www.noetive.io/semantik" },
      { "name": "Bud", "url": "https://www.noetive.io/bud" },
      { "name": "MCP", "url": "https://www.noetive.io/mcp" },
      { "name": "Pricing", "url": "https://www.noetive.io/pricing" },
      { "name": "Blog", "url": "https://www.noetive.io/blog" },
      { "name": "Use Cases", "url": "https://www.noetive.io/patterns" }
    ],
    "cta": {
      "name": "Get started",
      "url": "https://www.noetive.io/access"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Noetive",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["guides/quickstart", "guides/mcp-setup"]
          },
          { "group": "Overview", "pages": ["platform/architecture"] },
          { "group": "Account", "pages": ["platform/api-keys"] },
          { "group": "Billing", "pages": ["platform/billing", "platform/usage"] }
        ]
      },
      {
        "tab": "Semantik",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["semantik/overview", "semantik/quickstart", "semantik/namespaces", "semantik/faq"]
